class_name GlbMap
extends MapBase

## A map generated by tools/generate_15_maps.py: res://assets/maps/<id>/<id>.glb, plus one
## <id>__<expansion>.glb per expansion. Node names follow the generator's contract:
##   Set_* (ink) · Flat_* (no ink) · Glow_* (emissive) · Prop_<group>_<n> · Spawn_<n>
##
## Chaos is data (maps.json "chaos_stages" and "idle"): each stage lists FX that move prop
## groups or touch the studio (shake, fog, low gravity, slip). Every FX is a pure function of
## the time since its stage began, so a chaos moment replays identically on scrub and retake.

@export var map_id := ""

var props := {}        # group -> Array[Node3D]
var _rest := {}        # Node3D -> Transform3D
var _glows: Array = [] # MeshInstance3D emissive meshes
var _glow_base := {}   # MeshInstance3D -> Material
var _spawns: Array = []
var _stage := 0
var _t0 := [0.0, 0.0, 0.0, 0.0]   # start time of each stage (index 1..3)
var _stages: Array = []
var _idle: Array = []
var _hidden: Array = []
var _swarms := {}      # fx key -> MultiMeshInstance3D
var _glow_dirty := false
var _glow_dark: StandardMaterial3D

func build() -> void:
	var path := "res://assets/maps/%s/%s.glb" % [map_id, map_id]
	var root := (load(path) as PackedScene).instantiate() as Node3D
	add_child(root)
	_dress(root)

func build_expansion(id: String) -> Node3D:
	var path := "res://assets/maps/%s/%s__%s.glb" % [map_id, map_id, id]
	if not ResourceLoader.exists(path):
		return null
	var root := (load(path) as PackedScene).instantiate() as Node3D
	_dress(root)
	return root

func spawn_points() -> Array:
	if _spawns.is_empty():
		return super.spawn_points()
	return _spawns

## Studio Vinyl materials, ink on the outer shapes, and an index of props / glows / spawns.
func _dress(root: Node) -> void:
	Style.restyle(root)
	_walk(root)

func _walk(n: Node) -> void:
	var name := String(n.name)
	if name.begins_with("Prop_"):
		var parts := name.split("_")
		var group := "_".join(parts.slice(1, parts.size() - 1))
		if not props.has(group):
			props[group] = []
		props[group].append(n)
		_rest[n] = (n as Node3D).transform
	elif name.begins_with("Spawn_"):
		_spawns.append((n as Node3D).global_position if n.is_inside_tree() else _world_pos(n))
	var mi := n as MeshInstance3D
	if mi and mi.mesh:
		var mat := mi.get_active_material(0) as BaseMaterial3D
		var glowing := mat != null and mat.emission_enabled
		if glowing:
			_glows.append(mi)
			_glow_base[mi] = mat
		elif not name.begins_with("Flat") and mi.mesh is ArrayMesh and mi.mesh.get_aabb().get_longest_axis_size() > 0.045:
			if mat == null or mat.transparency == BaseMaterial3D.TRANSPARENCY_DISABLED:
				var rim := Ink.rim(mi.mesh as ArrayMesh)
				Ink.calm(rim, mat)
				mi.add_child(rim)
	for c in n.get_children():
		_walk(c)

static func _world_pos(n: Node) -> Vector3:
	var p := Vector3.ZERO
	var k := n
	while k is Node3D:
		p = (k as Node3D).transform * p
		k = k.get_parent()
	return p

# ── chaos ─────────────────────────────────────────────────────────────────────────
func configure(info: Dictionary) -> void:
	_stages = info.get("chaos_stages", [])
	_idle = info.get("idle", [])
	_hidden = info.get("hidden", [])
	_apply_hidden()

func _apply_hidden() -> void:
	for g in _hidden:
		for p in props.get(String(g), []):
			(p as Node3D).scale = Vector3.ONE * 0.001

func chaos_set(stage: int, now: float, main: Node) -> void:
	if stage > _stage:
		for k in range(_stage + 1, stage + 1):
			_t0[k] = now
	_stage = stage
	if stage == 0:
		_reset(main)

func chaos_state(now: float) -> Dictionary:
	return {"stage": _stage, "elapsed": [0.0, now - _t0[1], now - _t0[2], now - _t0[3]]}

func chaos_restore(s: Dictionary, now: float, main: Node) -> void:
	_reset(main)
	_stage = int(s.get("stage", 0))
	var el: Array = s.get("elapsed", [0.0, 0.0, 0.0, 0.0])
	for k in range(1, 4):
		_t0[k] = now - float(el[k])

func _reset(main: Node) -> void:
	for n in _rest:
		(n as Node3D).transform = _rest[n]
	for mi in _glow_base:
		(mi as MeshInstance3D).set_surface_override_material(0, _glow_base[mi])
	for k in _swarms:
		(_swarms[k] as Node3D).visible = false
	_apply_hidden()
	main.chaos_shake = 0.0
	main.lowgrav = false
	main.slippery = false
	main.light_scale = 1.0
	main.flash = 0.0
	main.env.fog_enabled = false
	_glow_dirty = false

## Called every studio step: rest pose, then every active FX in order.
func chaos_tick(now: float, main: Node) -> void:
	for n in _rest:
		(n as Node3D).transform = _rest[n]
	_apply_hidden()
	main.chaos_shake = 0.0
	main.lowgrav = false
	main.slippery = false
	main.light_scale = 1.0
	main.flash = 0.0
	if _glow_dirty:
		for mi in _glow_base:
			(mi as MeshInstance3D).set_surface_override_material(0, _glow_base[mi])
		_glow_dirty = false
	var fog := false
	var used_swarms := {}
	for fx in _idle:
		_fx(fx, now, main, used_swarms)
	for k in range(1, _stage + 1):
		if k - 1 >= _stages.size():
			break
		for fx in _stages[k - 1].get("fx", []):
			if _fx(fx, now - _t0[k], main, used_swarms):
				fog = true
	if not fog:
		main.env.fog_enabled = false
	for key in _swarms:
		(_swarms[key] as Node3D).visible = used_swarms.has(key)

static func _h(n: Object, salt: float) -> float:
	var x := sin(float(String(n.get("name")).hash() % 10007) * 12.9898 + salt * 78.233) * 43758.5453
	return x - floor(x)

static func _bounce(x: float) -> float:
	x = clampf(x, 0.0, 1.0)
	if x < 1.0 / 2.75:
		return 7.5625 * x * x
	if x < 2.0 / 2.75:
		x -= 1.5 / 2.75
		return 7.5625 * x * x + 0.75
	if x < 2.5 / 2.75:
		x -= 2.25 / 2.75
		return 7.5625 * x * x + 0.9375
	x -= 2.625 / 2.75
	return 7.5625 * x * x + 0.984375

func _group(fx: Dictionary) -> Array:
	var g := String(fx.get("group", ""))
	if g == "*":
		var all: Array = []
		for k in props:
			all.append_array(props[k])
		return all
	return props.get(g, [])

## Applies one FX at elapsed time e. Returns true if it switched fog on.
func _fx(fx: Dictionary, e: float, main: Node, used_swarms: Dictionary) -> bool:
	if e < 0.0:
		return false
	var list := _group(fx)
	var type := String(fx.get("type", ""))
	match type:
		"topple":
			var angle := deg_to_rad(float(fx.get("angle", 82.0)))
			for i in list.size():
				var n: Node3D = list[i]
				var k := _bounce((e - i * float(fx.get("stagger", 0.08))) / float(fx.get("time", 0.6)))
				var dir := float(fx.get("dir", -1.0))
				var a := _h(n, 1.0) * TAU if dir < 0.0 else deg_to_rad(dir)
				var axis := Vector3(cos(a), 0, sin(a))
				n.transform = Transform3D(Basis(axis, angle * k) * _rest[n].basis, _rest[n].origin)
		"scatter":
			for i in list.size():
				var n: Node3D = list[i]
				var k := clampf((e - i * float(fx.get("stagger", 0.03))) / float(fx.get("time", 0.9)), 0.0, 1.0)
				var a := _h(n, 2.0) * TAU
				var spread := float(fx.get("spread", 1.2)) * (0.45 + 0.55 * _h(n, 3.0))
				var r: Transform3D = _rest[n]
				var pos := r.origin + Vector3(cos(a), 0, sin(a)) * spread * k
				pos.y = lerpf(r.origin.y, float(fx.get("floor", 0.0)), k) + float(fx.get("height", 0.9)) * 4.0 * k * (1.0 - k)
				var spin := float(fx.get("spin", 7.0)) * k * (0.5 + _h(n, 4.0))
				n.transform = Transform3D(Basis(Vector3(sin(a), 0.4, cos(a)).normalized(), spin) * r.basis, pos)
		"drop":
			for i in list.size():
				var n: Node3D = list[i]
				var k := _bounce((e - i * float(fx.get("stagger", 0.1))) / float(fx.get("time", 0.7)))
				var r: Transform3D = _rest[n]
				var pos := r.origin
				pos.y = lerpf(r.origin.y, float(fx.get("floor", 0.0)), k)
				n.transform = Transform3D(Basis(Vector3(1, 0, 0), 0.5 * k * (_h(n, 5.0) - 0.5)) * r.basis, pos)
		"float":
			for i in list.size():
				var n: Node3D = list[i]
				var r: Transform3D = _rest[n]
				var rise := smoothstep(0.0, float(fx.get("rise", 1.6)), e)
				var pos := r.origin + Vector3(0, float(fx.get("height", 0.7)) * rise * (0.6 + 0.4 * _h(n, 6.0)) + sin(e * 1.3 + i) * 0.06 * rise, 0)
				n.transform = Transform3D(Basis(Vector3(_h(n, 7.0), 1, _h(n, 8.0)).normalized(), e * 0.4 * rise) * r.basis, pos)
		"spin":
			var ramp := float(fx.get("ramp", 1.0))
			var speed := float(fx.get("speed", 10.0))
			var ang := speed * (e * e / (2.0 * ramp) if e < ramp else ramp * 0.5 + (e - ramp))
			for n in list:
				var r: Transform3D = _rest[n]
				var lift := float(fx.get("lift", 0.0)) * smoothstep(0.0, 2.0, e)
				n.transform = Transform3D(Basis(Vector3.UP, ang) * r.basis, r.origin + Vector3(0, lift, 0))
		"orbit":
			var c: Array = fx.get("center", [0, 0])
			for i in list.size():
				var n: Node3D = list[i]
				var r: Transform3D = _rest[n]
				var a := e * float(fx.get("speed", 1.2)) + i * TAU / maxf(1.0, list.size())
				var rad := float(fx.get("radius", 1.6))
				var pos := Vector3(float(c[0]) + cos(a) * rad, r.origin.y, float(c[1]) + sin(a) * rad)
				n.transform = Transform3D(Basis(Vector3.UP, -a) * r.basis, pos)
		"bob":
			for i in list.size():
				var n: Node3D = list[i]
				var r: Transform3D = _rest[n]
				n.transform = Transform3D(r.basis, r.origin + Vector3(0, sin(e * float(fx.get("speed", 1.5)) + i * 1.3) * float(fx.get("amp", 0.05)), 0))
		"conveyor":
			var ax: Array = fx.get("axis", [1, 0])
			var axis := Vector3(float(ax[0]), 0, float(ax[1])).normalized()
			var length := float(fx.get("length", 2.0))
			var start := INF
			for n in list:
				start = minf(start, (_rest[n] as Transform3D).origin.dot(axis))
			# each item slides along the belt and wraps back to its start
			for n in list:
				var r: Transform3D = _rest[n]
				var along := r.origin.dot(axis) - start
				var moved := fposmod(along + e * float(fx.get("speed", 1.0)), length) - along
				n.transform = Transform3D(r.basis, r.origin + axis * moved)
		"show":
			for n in list:
				var r: Transform3D = _rest[n]
				var k := clampf(e / float(fx.get("time", 0.4)), 0.0, 1.0)
				var s := 1.0 + sin(k * PI) * 0.25 if k < 1.0 else 1.0 + sin(e * 9.0) * 0.06
				n.transform = Transform3D(r.basis.scaled(Vector3(1, k * s, 1)), r.origin)
		"melt":
			for n in list:
				var r: Transform3D = _rest[n]
				var k := smoothstep(0.0, float(fx.get("time", 2.0)), e)
				n.transform = Transform3D(r.basis.scaled(Vector3(1.0 + 0.35 * k, 1.0 - 0.7 * k, 1.0 + 0.35 * k)), r.origin)
		"wobble":
			for i in list.size():
				var n: Node3D = list[i]
				var r: Transform3D = _rest[n]
				n.transform = Transform3D(Basis(Vector3(0, 0, 1), sin(e * float(fx.get("speed", 9.0)) + i) * float(fx.get("amp", 0.15))) * r.basis, r.origin)
		"gust":
			var d: Array = fx.get("dir", [1, 0])
			var push := Vector3(float(d[0]), 0, float(d[1])).normalized() * float(fx.get("strength", 1.6))
			for i in list.size():
				var n: Node3D = list[i]
				var r: Transform3D = _rest[n]
				var k := smoothstep(0.0, float(fx.get("time", 1.2)), e - i * 0.05)
				var pos := r.origin + push * k * (0.6 + 0.4 * _h(n, 9.0)) + Vector3(0, sin(k * PI) * 0.3, 0)
				n.transform = Transform3D(Basis(Vector3(0, 0, 1), k * 1.4 * (_h(n, 10.0) - 0.5)) * r.basis, pos)
		"flicker":
			var cols: Array = fx.get("colors", ["#FF5F56", "#27C93F", "#4A90E2", "#FFBD2E"])
			var frame := int(floor(e * float(fx.get("fps", 12.0))))
			for i in _glows.size():
				var mi: MeshInstance3D = _glows[i]
				mi.set_surface_override_material(0, Style.glow(Color(String(cols[(frame + i) % cols.size()]))))
			_glow_dirty = true
		"dim":
			# blackout: the set goes dark; "stutter" lets the power cough back on now and then
			var k := smoothstep(0.0, float(fx.get("fade", 0.3)), e)
			var on := false
			if fx.has("stutter"):
				var ph := fposmod(e, float(fx["stutter"]))
				on = ph < 0.08 or (ph > 0.16 and ph < 0.22)
			var level := 1.0 if on else lerpf(1.0, float(fx.get("amount", 0.15)), k)
			main.light_scale = minf(main.light_scale, level)
			if fx.get("glows_off", false) and not on and k > 0.5:
				if _glow_dark == null:
					_glow_dark = Style.toon(Style.swatch("space_gray"))
				for mi in _glows:
					(mi as MeshInstance3D).set_surface_override_material(0, _glow_dark)
				_glow_dirty = true
		"flash":
			# lightning: a double pulse every few seconds
			var every := float(fx.get("every", 2.0))
			var ph := fposmod(e, every)
			var len := float(fx.get("length", 0.12))
			var f := 0.0
			if ph < len:
				f = 1.0 - ph / len
			elif ph > len * 1.8 and ph < len * 2.8:
				f = 0.7 * (1.0 - (ph - len * 1.8) / len)
			main.flash = maxf(main.flash, f * float(fx.get("strength", 1.0)))
		"shake":
			main.chaos_shake = maxf(main.chaos_shake, float(fx.get("amount", 0.4)))
		"lowgrav":
			main.lowgrav = sin(e * float(fx.get("flicker", 0.0)) * TAU) >= 0.0 if fx.has("flicker") else true
		"slip":
			main.slippery = true
		"fog":
			main.env.fog_enabled = true
			main.env.fog_light_color = Style.snap(Color(String(fx.get("color", "#F5F2EB"))))
			main.env.fog_density = float(fx.get("density", 0.06)) * smoothstep(0.0, 1.5, e)
			return true
		"swarm":
			var key := "%s:%s" % [fx.get("color", ""), fx.get("count", 0)]
			used_swarms[key] = true
			_swarm(key, fx, e)
	return false

## A flock of small smooth shapes (shoppers, gulls, paper, bubbles, popcorn) on deterministic paths.
func _swarm(key: String, fx: Dictionary, e: float) -> void:
	var count := int(fx.get("count", 14))
	var mm_inst: MultiMeshInstance3D = _swarms.get(key)
	if mm_inst == null:
		var mesh := SphereMesh.new()
		mesh.radial_segments = 20
		mesh.rings = 10
		var mm := MultiMesh.new()
		mm.transform_format = MultiMesh.TRANSFORM_3D
		mm.mesh = mesh
		mm.instance_count = count
		mm_inst = MultiMeshInstance3D.new()
		mm_inst.multimesh = mm
		mm_inst.material_override = Style.toon(Color(String(fx.get("color", "#F5F2EB"))))
		if fx.has("colors"):   # confetti: each piece its own palette colour
			mm.use_colors = true
			var palette: Array = fx["colors"]
			mm.instance_count = 0
			mm.use_colors = true
			mm.instance_count = count
			for i in count:
				mm.set_instance_color(i, Style.snap(Color(String(palette[i % palette.size()]))))
			var mat := Style.toon(Color.WHITE)
			mat.vertex_color_use_as_albedo = true
			mm_inst.material_override = mat
		add_child(mm_inst)
		_swarms[key] = mm_inst
	var c: Array = fx.get("center", [0, 0])
	var size: Array = fx.get("size", [0.12, 0.08, 0.12])
	var mode := String(fx.get("path", "circle"))
	var grow := smoothstep(0.0, 0.5, e)
	for i in count:
		var ph := float(i) / count
		var pos: Vector3
		match mode:
			"rush":    # crowd running across the room and wrapping around
				var lane := (ph - 0.5) * float(fx.get("width", 3.0))
				var x := fposmod(e * float(fx.get("speed", 2.0)) * (0.8 + 0.4 * fposmod(ph * 7.3, 1.0)) + ph * 9.0, 10.0) - 5.0
				pos = Vector3(x, float(fx.get("height", 0.5)) + absf(sin(e * 9.0 + i)) * 0.12, float(c[1]) + lane)
			"fountain": # popcorn / bubbles shooting up and falling back
				var cyc := fposmod(e * float(fx.get("speed", 1.0)) + ph, 1.0)
				var a := ph * 37.0
				var rad := cyc * float(fx.get("radius", 1.2))
				pos = Vector3(float(c[0]) + cos(a) * rad, float(fx.get("height", 0.5)) + 4.0 * cyc * (1.0 - cyc) * float(fx.get("lift", 1.2)), float(c[1]) + sin(a) * rad)
			"tornado":
				var cyc := fposmod(e * 0.4 + ph, 1.0)
				var a := e * float(fx.get("speed", 4.0)) + ph * TAU * 3.0
				var rad := 0.25 + cyc * float(fx.get("radius", 1.4))
				pos = Vector3(float(c[0]) + cos(a) * rad, 0.2 + cyc * float(fx.get("height", 2.6)), float(c[1]) + sin(a) * rad)
			_:          # circle: gulls / flies
				var a := e * float(fx.get("speed", 1.2)) * (0.8 + 0.4 * fposmod(ph * 3.7, 1.0)) + ph * TAU
				var rad := float(fx.get("radius", 2.5)) * (0.7 + 0.3 * fposmod(ph * 5.1, 1.0))
				pos = Vector3(float(c[0]) + cos(a) * rad, float(fx.get("height", 1.8)) + sin(e * 3.0 + i) * 0.25, float(c[1]) + sin(a) * rad)
		var flap := 1.0 + 0.35 * sin(e * 18.0 + i) if mode == "circle" else 1.0
		var sc := Vector3(float(size[0]) * flap, float(size[1]), float(size[2])) * grow * 2.0
		mm_inst.multimesh.set_instance_transform(i, Transform3D(Basis.from_scale(sc), pos))
